# Локальная разработка и тесты (ADR-010). Скопируйте в .env: `pnpm db:up` делает это сам.
# Пароли ниже — только для dev/test, в прод не попадают (развёртывание — ADR-011). Секретов в репозитории нет.

NODE_ENV=development

# API
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Приложение ходит под oxrana_app (без BYPASSRLS), миграции — под oxrana_owner (ADR-003).
DATABASE_URL=postgres://oxrana_app:oxrana@127.0.0.1:5432/oxrana
DATABASE_ADMIN_URL=postgres://oxrana_owner:oxrana@127.0.0.1:5432/oxrana

# Пароли ролей, которые создаёт scripts/db-up.sh (должны совпадать с URL выше).
OXRANA_OWNER_PASSWORD=oxrana
OXRANA_APP_PASSWORD=oxrana
