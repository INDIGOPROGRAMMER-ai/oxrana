{
  "name": "oxrana",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project components",
    "test:components": "vitest run --project components",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:deploy": "bash deploy/test/oxranactl.test.sh && bash deploy/test/setup-vps.test.sh",
    "db:up": "bash scripts/db-up.sh",
    "db:migrate": "pnpm --filter @oxrana/db migrate",
    "db:seed": "pnpm --filter @oxrana/db seed",
    "db:reset": "bash scripts/db-reset.sh",
    "fixture:engine": "pnpm --filter @oxrana/db freeze-fixture",
    "bootstrap": "pnpm --silent --filter @oxrana/api bootstrap"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
