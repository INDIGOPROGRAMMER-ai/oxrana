# Образец /opt/oxrana/.env на сервере стенда. Файл создаёт deploy/setup-vps.sh (пароли — случайные);
# здесь только перечень переменных. Реальные значения в репозиторий не попадают.

# Домен стенда (A-запись на IP сервера) и адрес для служебных писем Let's Encrypt
STAND_DOMAIN=stand.example.ru
ACME_EMAIL=owner@example.ru

# Пароли PostgreSQL: суперпользователь контейнера, владелец схемы (миграции), роль приложения (RLS)
POSTGRES_PASSWORD=change-me
OXRANA_OWNER_PASSWORD=change-me
OXRANA_APP_PASSWORD=change-me
