# Caddy стенда (ADR-019): HTTPS от Let's Encrypt по HTTP-01 на домене из STAND_DOMAIN.
# Один домен: кабинет — /, пост — /gate/, API — /api (префикс срезается). Остальное наружу не выходит.
{
	email {$ACME_EMAIL}
	servers {
		# HTTP/3 (UDP) не используем: в брандмауэре открыты только TCP 22, 80, 443
		protocols h1 h2
	}
}

# Общие правила раздачи статики: хэшированные файлы кэшируются навсегда, HTML — никогда;
# неизвестный путь вне /assets/ отдаёт index.html (маршрутизатор SPA).
(static) {
	encode zstd gzip
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$STAND_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Журнал доступа без cookie, токенов и строки запроса: в ней бывают номера машин и телефоны
	# (поиск), а в журналах ПДн быть не должно. Ссылки приглашений несут токен во фрагменте
	# и до сервера не доходят.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ?
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}

	handle /api/* {
		uri strip_prefix /api
		# SSE (табло, посты): без буферизации ответа
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	redir /gate /gate/ 308
	handle /gate/* {
		uri strip_prefix /gate
		root * /srv/gate
		import static
	}

	handle {
		root * /srv/web
		import static
	}
}
